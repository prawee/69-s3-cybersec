# REST

@adminEmail = <ADMIN_EMAIL>
@adminPassword = <ADMIN_PASSWORD>
@adminFirstname = <ADMIN_FIRSTNAME>
@adminLastname = <ADMIN_LASTNAME>
@adminResetToken = <ADMIN_RESET_TOKEN>
@adminNewPassword = <ADMIN_NEW_PASSWORD>
@rememberMe = false
@adminToken = <ADMIN_TOKEN>
@userUsername = <USER_USERNAME>
@userEmail = <USER_EMAIL>
@userPassword = <USER_PASSWORD>
@userIdentifier = <USER_IDENTIFIER>
@userResetCode = <USER_RESET_CODE>
@userNewPassword = <USER_NEW_PASSWORD>
@userToken = <USER_TOKEN>
@studentId = <STUDENT_ID>
@studentFields = <STUDENT_FIELDS>
@page = 1
@pageSize = 10
@studentName = <STUDENT_NAME>
@studentMobile = <STUDENT_MOBILE>
@studentCardId = <STUDENT_CARDID>
@subjectName = <SUBJECT_NAME>
@teacherName = <TEACHER_NAME>

## 1. Admin Section
### 1.1 Login
POST http://localhost:9093/admin/login
Content-Type: application/json

{
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}",
    "rememberMe": {{rememberMe}}
}

### 1.2 Signup
POST http://localhost:9093/admin/register
Content-Type: application/json

{
    "firstname": "{{adminFirstname}}",
    "lastname": "{{adminLastname}}",
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
}

### 1.3 Forgot Password
POST http://localhost:9093/admin/forgot-password
Content-Type: application/json

{
    "email": "{{adminEmail}}"
}

### 1.3.1 Reset Password
POST http://localhost:9093/admin/reset-password
Content-Type: application/json

{
    "resetPasswordToken": "{{adminResetToken}}",
    "password": "{{adminNewPassword}}"
}

### 1.4 Profile
GET http://localhost:9093/admin/me
Authorization: Bearer {{adminToken}}
Content-Type: application/json


## 2. User Section
### 2.1 Login
POST http://localhost:9093/api/auth/local
Content-Type: application/json

{
    "identifier": "{{userIdentifier}}",
    "password": "{{userPassword}}"
}

### 2.2 Signup
POST http://localhost:9093/api/auth/local/register
Content-Type: application/json

{
    "username": "{{userUsername}}",
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
}

### 2.3 Forgot Password
POST http://localhost:9093/api/auth/forgot-password
Content-Type: application/json

{
    "email": "{{userEmail}}"
}

### 2.3.1 Reset Password
POST http://localhost:9093/api/auth/reset-password
Content-Type: application/json

{
    "code": "{{userResetCode}}",
    "password": "{{userNewPassword}}",
    "passwordConfirmation": "{{userNewPassword}}"
}

### 2.4 Profile
GET http://localhost:9093/api/users/me
Authorization: Bearer {{userToken}}


## 3.Content Section
### 3.1 Student
#### 3.1.1 Create Student
POST http://localhost:9093/api/students
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
    "data": {
        "name": "{{studentName}}",
        "mobile": "{{studentMobile}}",
        "cardId": "{{studentCardId}}"
    }
}

#### 3.1.2 List All Students
GET http://localhost:9093/api/students
Authorization: Bearer {{userToken}}

#### 3.1.3 Get Student By ID
GET http://localhost:9093/api/students/{{studentId}}
Authorization: Bearer {{userToken}}

#### 3.1.4 Update Student By ID
PUT http://localhost:9093/api/students/{{studentId}}
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
    "data": {
        "name": "{{studentName}}-updated-03",
        "mobile": "{{studentMobile}}"
    }
}

### 3.2 Subject
#### 3.2.1 Create Subject
POST http://localhost:9093/api/subjects
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
    "data": {
        "name": "{{subjectName}}"
    }
}

#### 3.2.2 List All Subjects
GET http://localhost:9093/api/subjects
Authorization: Bearer {{userToken}}

#### 3.2.3 Get Subject By ID
GET http://localhost:9093/api/subjects/1
Authorization: Bearer {{userToken}}

#### 3.2.4 Update Subject By ID
PUT http://localhost:9093/api/subjects/1
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
    "data": {
        "name": "{{subjectName}}-updated-01"
    }
}

### 3.3 Teacher
#### 3.3.1 Create Teacher
POST http://localhost:9093/api/teachers
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
    "data": {
        "name": "{{teacherName}}"
    }
}

#### 3.3.2 List All Teachers
GET http://localhost:9093/api/teachers
Authorization: Bearer {{userToken}}

#### 3.3.3 Get Teacher By ID
GET http://localhost:9093/api/teachers/1
Authorization: Bearer {{userToken}}

#### 3.3.4 Update Teacher By ID
PUT http://localhost:9093/api/teachers/1
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
    "data": {
        "name": "{{teacherName}}-updated-01"
    }
}